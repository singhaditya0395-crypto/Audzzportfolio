# Copy this file to .env and fill in your real values. Never commit .env.

# Gmail address that will SEND the notification (can be the same as NOTIFY_EMAIL)
GMAIL_ADDRESS=your.sending.address@gmail.com

# Gmail App Password (NOT your normal password):
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password (name it e.g. "portfolio-backend") and paste the 16-char code below
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where meeting request notifications get sent (defaults to singh.aditya0395@gmail.com if unset)
NOTIFY_EMAIL=singh.aditya0395@gmail.com

# Comma-separated list of frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where every submission gets appended as a JSON line, as a backup in case email
# sending fails (misconfigured creds, network blip, etc). Defaults to Backend/data/meetings_log.jsonl
LOG_FILE_PATH=data/meetings_log.jsonl
