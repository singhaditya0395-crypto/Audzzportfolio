# Copy this file to .env and fill in your real values. Never commit .env.

# Gmail address that will SEND the notification (can be the same as NOTIFY_EMAIL)
GMAIL_ADDRESS=your.sending.address@gmail.com

# Gmail App Password (NOT your normal password):
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password (name it e.g. "portfolio-backend") and paste the 16-char code below
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where meeting request notifications get sent. Required - if unset, email sending
# and the /api/contact endpoint (used to build the calendar invite) are both skipped.
NOTIFY_EMAIL=your.notify.address@gmail.com

# Comma-separated list of frontend origins allowed to call this API
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where every submission gets appended as a JSON line, as a backup in case email
# sending fails (misconfigured creds, network blip, etc). Defaults to Backend/data/meetings_log.jsonl
LOG_FILE_PATH=data/meetings_log.jsonl

# --- Optional: rate limiting + data-rights endpoints (both need Upstash Redis) ---
# Create a free database at https://console.upstash.com, then copy its REST
# credentials below. Without these, rate limiting fails open (allows all
# requests) and /api/submissions/* returns 503 - the core contact flow still
# works fine either way.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxx

# Required (together with Upstash above) for the "request/delete my data"
# endpoints to activate - without a valid key, submissions are never persisted
# beyond the email + best-effort log, since storing PII unencrypted isn't an
# acceptable fallback. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: Cloudflare Turnstile CAPTCHA (invisible, no third-party tracking) ---
# Create a free widget at https://dash.cloudflare.com/?to=/:account/turnstile
# (mode: "Managed" or "Invisible"). SITE_KEY is public and safe to expose in the
# browser; only SECRET_KEY is sensitive. Without these, the widget never loads
# and the honeypot remains the only bot defense - the form still works fine.
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000000000000
